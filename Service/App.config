<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

	<appSettings>
		<add key ="A_threshold" value ="5"/>
		<add key ="W_threshold" value ="10"/>
	</appSettings>
	
	<system.serviceModel>

		<bindings>
			<netTcpBinding>
				<binding
					name ="tcpBinding"
					transferMode="Streamed"
					maxReceivedMessageSize="2147483647"
					sendTimeout="00:10:00"
					receiveTimeout="00:10:00"
					openTimeout="00:01:00"
					closeTimeout="00:01:00"/>
			</netTcpBinding>
		</bindings>

		<services>
			<service name ="Service.Services.DroneService">
				<endpoint
					address="DroneServiceAddress"
					binding="netTcpBinding"
					bindingConfiguration="tcpBinding"
					contract="Common.Contracts.IDroneService" />
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:4002" />
					</baseAddresses>
				</host>
			</service>
		</services>
	</system.serviceModel>
</configuration>