<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

	<appSettings>
		<add key ="A_threshold" value ="5"/>
		<add key ="W_threshold" value ="10"/>
	</appSettings>
	
	<system.serviceModel>
		<services>
			<service name="Service.DroneService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:4002" />
					</baseAddresses>
				</host>
				<endpoint
					address="ServiceDrone"
					binding="netTcpBinding"
					contract="Common.IDroneService" />
			</service>

		</services>
	</system.serviceModel>
</configuration>